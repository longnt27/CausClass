# Never commit real credentials. Existing shell/CI variables take precedence.
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
# Historical defaults; verify provider availability before an online experiment.
GEMINI_SYNTHETIC_MODEL=gemini-3-flash-preview
DEEPSEEK_MODEL=deepseek-chat
WANDB_MODE=disabled
# Optional absolute paths (set in the shell BEFORE starting Python):
# CAUSCLASS_HOME=/path/to/CausClass
# CAUSCLASS_DATA_DIR=/path/to/data
# CAUSCLASS_OUTPUT_DIR=/path/to/results
# CAUSCLASS_ENV_FILE=/path/to/.env
